# Example configuration for Nessus Security Center API access
# DO NOT commit this file with real credentials!

# Security Center connection
NESSUS_URL=https://sc.example.com
NESSUS_USERNAME=your_username
NESSUS_PASSWORD=your_password

# SSL Certificate (optional)
# NESSUS_CERT=/path/to/ca-certificate.pem

# Scan IDs to fetch (comma-separated)
SCAN_IDS=123,456,789

# Output options
OUTPUT_DIR=./scan_results
