# FreeRADIUS PostgreSQL Database Configuration
# Copy this file to .env and update with your actual credentials
# NEVER commit .env to version control!

# Database Host
RADIUS_DB_HOST=localhost

# Database Port (default PostgreSQL port)
RADIUS_DB_PORT=5432

# Database Name
RADIUS_DB_NAME=radius

# Database User
RADIUS_DB_USER=radius

# Database Password (REQUIRED - update this!)
RADIUS_DB_PASSWORD=your_secure_password_here
