#192.168.1.101
#192.168.1.102

# Production Servers - Building B
#192.168.2.100
#192.168.2.101

# Development Servers
#dev-idrac-01.example.com
#dev-idrac-02.example.com

# Test Servers
#test-idrac-01.example.com
