# Dell iDRAC Configuration
# Copy this file to .env and update with your credentials
# NEVER commit .env to version control!

# iDRAC Authentication
IDRAC_USERNAME=root
IDRAC_PASSWORD=your_secure_password_here

# SSL Certificate Verification
# Set to 'true' to enable SSL certificate verification
# Set to 'false' to disable (useful for self-signed certificates)
IDRAC_VERIFY_CERT=false

# Certificate Path (optional)
# Path to CA certificate bundle for SSL verification
# Only used if IDRAC_VERIFY_CERT=true
#CERT_PATH=/path/to/your/ca_bundle.crt
